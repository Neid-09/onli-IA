# Supabase Configuration
# Obtén estas credenciales desde tu panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# (Opcional) URL fija para redirección de Auth en Producción
# Si no se define, toma dinámicamente window.location.origin
VITE_SITE_URL=http://localhost:5173

# Configuración de Google Gemini IA & OCR Multimodal
VITE_GEMINI_API_KEY=tu-api-key-de-gemini
